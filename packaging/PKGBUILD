# Paquet local de zettel-ai, construit depuis ce dépôt (les sources non commitées comprises).
#   cd packaging && makepkg -si        # construit, lance les tests, installe
# Installe : /usr/bin/zettel-ai, /usr/bin/zettel-valider, /usr/bin/hyprwhspr-journal,
#            le paquet Python « zettel », les unités systemd utilisateur (inactives) et
#            /usr/share/doc/zettel-ai/config.exemple.toml (modèle de ~/.config/zettel-ai/config.toml).
# Maintainer: Quentin Nicoud

pkgname=zettel-ai
pkgver=0.2.0
pkgrel=1
pkgdesc="Journal vocal dicté -> notes Zettelkasten org-roam, avec un LLM local (Ollama)"
arch=('any')
license=('custom:none')
depends=('python' 'python-requests' 'git' 'libnotify')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=('ollama-cuda: LLM local (Qwen3.5-9B, bge-m3) ; ou ollama'
            'hyprwhspr: dictée vocale (coupée pendant le traitement)'
            'kitty: terminal ouvert par un clic sur la notification (réglage TERMINAL)'
            'emacs: org-roam-db-sync après validation'
            'curl: vérification d''Ollama par zettel-ai.service')

_racine="$startdir/.."
_sources=(pyproject.toml config.exemple.toml zettel tests systemd hyprwhspr-journal)

prepare() {
  # Copie neuve à chaque build : un fichier supprimé du dépôt ne doit pas survivre dans src/
  if [ -d "$srcdir/$pkgname" ]; then rm -r -- "$srcdir/$pkgname"; fi
  mkdir -p "$srcdir/$pkgname"
  for f in "${_sources[@]}"; do
    cp -a "$_racine/$f" "$srcdir/$pkgname/"
  done
  find "$srcdir/$pkgname" -name __pycache__ -type d -prune -exec rm -r {} +
}

build() {
  cd "$pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"
  python -m pytest -q -p no:cacheprovider
}

package() {
  cd "$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm755 hyprwhspr-journal -t "$pkgdir/usr/bin/"
  install -Dm644 systemd/zettel-ai.service systemd/zettel-ai.timer \
    -t "$pkgdir/usr/lib/systemd/user/"
  # Modèle de ~/.config/zettel-ai/config.toml
  install -Dm644 config.exemple.toml -t "$pkgdir/usr/share/doc/$pkgname/"
}
